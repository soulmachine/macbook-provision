#!/usr/bin/python3
"""cliproxy-claude-usage — push Claude rate limits to gateway-only hosts.

A host with no native Claude login (mac-mini-2018-omarchy, coding-agent Q352/Q365)
cannot ask Anthropic's OAuth usage endpoint for its limits, and the gateway strips
the rate-limit headers from its answers. This machine holds the account tokens, so
it asks on the host's behalf: for each host, the first account in its
cliproxy-key-routing order, which is the account its requests use while it is live.

Only the usage answer travels, never a token. It lands in the host's
~/.local/state/cliproxy/claude-usage.json, where a local patch to Omarchy's
omarchy-agent-usage-claude collector reads it. When the host has that collector,
the push also refreshes the Agents bar record.

Usage: cliproxy-claude-usage [host ...]   (default: $CLAUDE_USAGE_HOSTS or mac-mini-2018-omarchy)
Runs every 5 minutes from ~/Library/LaunchAgents/com.cliproxy.claude-usage.plist.
"""

from __future__ import annotations

import datetime as dt
import json
import os
import re
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

AUTH_DIR = Path.home() / ".cli-proxy-api"
ROUTING = AUTH_DIR / "plugins" / "host-routing.yaml"
LOG = Path.home() / "Library" / "Logs" / "cliproxy-claude-usage.log"
USAGE_ENDPOINT = "https://api.anthropic.com/api/oauth/usage"
DEFAULT_HOSTS = "mac-mini-2018-omarchy"

# Runs on the target host: store the pushed record atomically, then regenerate
# the Agents bar record if this is an Omarchy host.
REMOTE = (
    "set -e; umask 077; d=~/.local/state/cliproxy; mkdir -p \"$d\"; "
    "cat >\"$d/.claude-usage.json.tmp\"; mv \"$d/.claude-usage.json.tmp\" \"$d/claude-usage.json\"; "
    "u=/usr/share/omarchy/bin/omarchy-agent-usage-update; "
    "if [ -x \"$u\" ]; then OMARCHY_PATH=/usr/share/omarchy \"$u\" --limits-only claude >/dev/null 2>&1 || true; fi"
)


def log(message: str) -> None:
    LOG.parent.mkdir(parents=True, exist_ok=True)
    with LOG.open("a") as handle:
        handle.write(dt.datetime.now().astimezone().strftime("%Y-%m-%dT%H:%M:%S%z") + " " + message + "\n")


# The sidecar is the plugin's own YAML subset: `- key:` starts a row, `name:` and
# `order: [a, b]` follow. Read just enough of it to map host -> first account.
def first_accounts() -> dict[str, str]:
    accounts: dict[str, str] = {}
    name = ""
    for line in ROUTING.read_text(encoding="utf-8").splitlines():
        line = line.split("#", 1)[0].strip()
        if line.startswith("- key:"):
            name = ""
        elif line.startswith("name:"):
            name = line.split(":", 1)[1].strip().strip("\"'")
        elif line.startswith("order:") and name:
            match = re.search(r"\[([^\]]*)\]", line)
            order = [a.strip().strip("\"'") for a in match.group(1).split(",")] if match else []
            if order and order[0]:
                accounts[name] = order[0]
    return accounts


def access_token(account: str) -> str:
    for path in sorted(AUTH_DIR.glob("claude-*.json")):
        try:
            auth = json.loads(path.read_text(encoding="utf-8"))
        except Exception:
            continue
        if str(auth.get("email") or "").lower() != account.lower() or auth.get("disabled"):
            continue
        expires = str(auth.get("expired") or "")
        try:
            lapsed = expires != "" and dt.datetime.fromisoformat(expires) <= dt.datetime.now(dt.timezone.utc)
        except ValueError:
            lapsed = False
        if lapsed:
            raise RuntimeError(f"{account}: token in {path.name} expired at {expires}; the gateway has not refreshed it")
        return str(auth.get("access_token") or "")
    raise RuntimeError(f"{account}: no enabled auth file in {AUTH_DIR}")


def probe(token: str) -> dict:
    request = urllib.request.Request(
        USAGE_ENDPOINT,
        headers={"Authorization": "Bearer " + token, "anthropic-beta": "oauth-2025-04-20", "Accept": "application/json"},
    )
    try:
        with urllib.request.urlopen(request, timeout=15) as response:
            return json.loads(response.read().decode("utf-8", errors="replace"))
    except urllib.error.HTTPError as error:
        raise RuntimeError(f"usage endpoint answered {error.code}") from None


def main() -> int:
    hosts = sys.argv[1:] or os.environ.get("CLAUDE_USAGE_HOSTS", DEFAULT_HOSTS).split()
    accounts = first_accounts()
    answers: dict[str, dict] = {}
    failed = 0
    for host in hosts:
        try:
            account = accounts.get(host)
            if not account:
                raise RuntimeError(f"no row in {ROUTING.name}")
            # One probe per account per run, however many hosts share it.
            if account not in answers:
                answers[account] = {"fetchedAtMs": round(time.time() * 1000), "account": account, "usage": probe(access_token(account))}
            push = subprocess.run(
                ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10", host, REMOTE],
                input=json.dumps(answers[account]), capture_output=True, text=True, timeout=120,
            )
            if push.returncode != 0:
                raise RuntimeError(f"push failed: {push.stderr.strip()[-300:]}")
        except Exception as error:
            log(f"{host} ERROR {error}")
            failed += 1
    return 1 if failed else 0


if __name__ == "__main__":
    raise SystemExit(main())
