#!/usr/bin/env python3
"""cliproxy-routing-sync — keep the key-routing sidecar's keys in step with host-keys.txt.

host-keys.txt (host -> inbound api-key) is the record of which key each host holds. The
cliproxy-key-routing sidecar keys its rows by that same key, so a rotation that is not copied
across silently drops the host to round-robin. Rows are matched by `name:`; the account `order`
stays hand-edited. Warns when a host has no row, a row has no host, or a key is missing from the
gateway config's api-keys. Called first by cliproxy-tier; safe any time (writes only on change,
and the plugin re-reads the sidecar on mtime). Exit 1 on any warning so the run log shows it.
"""
import os, re, sys
from pathlib import Path

H = Path.home()
KEYMAP = Path(os.environ.get("ROUTING_SYNC_KEYMAP", H / ".cli-proxy-api/host-keys.txt"))
SIDECAR = Path(os.environ.get("ROUTING_SYNC_SIDECAR", H / ".cli-proxy-api/plugins/host-routing.yaml"))
CONF = Path(os.environ.get("ROUTING_SYNC_CONF", "/opt/homebrew/etc/cliproxyapi.conf"))

keys = {}
for ln in KEYMAP.read_text().splitlines():
    ln = ln.strip()
    if ln and not ln.startswith("#"):
        host, key = ln.split()[:2]
        keys[host] = key

lines = SIDECAR.read_text().splitlines()
KEY_RE = re.compile(r'^(\s*-\s+key:\s*)"([^"]*)"(\s*)$')
NAME_RE = re.compile(r'^\s+name:\s*(\S+)\s*$')
updated, rows, warn = [], {}, []
for i, ln in enumerate(lines):
    m = KEY_RE.match(ln)
    if not m:
        continue
    name = None
    for j in range(i + 1, len(lines)):          # `name:` sits inside this row, before the next `- `
        if lines[j].lstrip().startswith("- "):
            break
        n = NAME_RE.match(lines[j])
        if n:
            name = n.group(1); break
    if name is None:
        warn.append(f"row at line {i + 1} has no name, left alone"); continue
    rows[name] = m.group(2)
    if name in keys and keys[name] != m.group(2):
        lines[i] = f'{m.group(1)}"{keys[name]}"{m.group(3)}'
        updated.append(name)

warn += [f"host {h} has no sidecar row (passes through to round-robin)" for h in keys if h not in rows]
warn += [f"row {n} has no host in {KEYMAP.name}" for n in rows if n not in keys]
conf = CONF.read_text() if CONF.exists() else ""
warn += [f"key for {h} is not in {CONF.name} api-keys" for h, k in keys.items() if k not in conf]

if updated:
    tmp = SIDECAR.with_name(SIDECAR.name + ".tmp")
    tmp.write_text("\n".join(lines) + "\n"); os.chmod(tmp, 0o600); os.replace(tmp, SIDECAR)
for w in warn:
    print("routing-sync: WARN " + w, file=sys.stderr)
print(f"routing-sync: {'updated ' + ', '.join(updated) if updated else 'ok'} ({len(rows)} rows, {len(keys)} hosts)")
sys.exit(1 if warn else 0)
