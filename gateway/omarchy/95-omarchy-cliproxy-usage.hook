[Trigger]
Operation = Install
Operation = Upgrade
Type = Path
Target = usr/bin/omarchy-agent
Target = usr/bin/omarchy-agent-usage-claude
Target = usr/bin/omarchy-agent-usage-codex

[Action]
Description = Re-applying the CLIProxyAPI patches to Omarchy's agent launcher and usage collectors...
When = PostTransaction
Exec = /usr/local/bin/omarchy-cliproxy-patch
