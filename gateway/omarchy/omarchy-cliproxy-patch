#!/bin/bash
# Re-apply the CLIProxyAPI limits patch to Omarchy's Claude usage collector
# (coding-agent Q365). /etc/pacman.d/hooks/95-omarchy-cliproxy-usage.hook runs
# this each time the omarchy package rewrites the collector.
set -uo pipefail
target=/usr/bin/omarchy-agent-usage-claude
patch_file=/usr/local/share/omarchy-cliproxy/omarchy-agent-usage-claude.patch

if patch --dry-run --reverse --force --silent "$target" "$patch_file" >/dev/null 2>&1; then
  echo "omarchy-cliproxy: $target is already patched"
elif patch --dry-run --forward --silent "$target" "$patch_file" >/dev/null 2>&1; then
  patch --forward --silent --no-backup-if-mismatch "$target" "$patch_file" && echo "omarchy-cliproxy: patched $target"
else
  echo "omarchy-cliproxy: the patch no longer applies to $target, so the Agents bar falls back to 'Waiting for auth'. Rebase $patch_file." >&2
  exit 1
fi
