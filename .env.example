GITHUB_TOKEN=ghp_xxxxx
TAILSCALE_AUTH_KEY=tskey-auth-xxxxx

# Optional — lets the tailscale role disable node-key expiry for this machine
# (the CLI has no equivalent command, so the role calls the REST API).
#
# PREFERRED: an OAuth client ("trust credential"). Create one at
# https://login.tailscale.com/admin/settings/oauth with the `devices:core`
# write scope — that scope's endpoint list is exactly what the role needs. The
# secret does not expire, is owned by the tailnet rather than by a person, and
# its use is recorded in the configuration audit log.
#TAILSCALE_OAUTH_CLIENT_ID=kxxxxxxxxCNTRL
#TAILSCALE_OAUTH_CLIENT_SECRET=tskey-client-xxxxx

# LEGACY: a personal API access token. Still honoured, but it is fully
# permitted (no scopes) and EXPIRES 90 DAYS after it is minted, after which the
# role's key-expiry task fails 401. Migrate to the OAuth pair above and revoke
# the token at https://login.tailscale.com/admin/settings/keys.
#TAILSCALE_API_ACCESS_TOKEN=tskey-api-xxxxx

# Optional — force the github role to use a specific SSH key when ~/.ssh holds
# several. Accepts an absolute path, a ~/ path, or a bare name resolved under
# ~/.ssh; the .pub suffix is optional. When unset, the preferred key by type is
# used (ed25519 > ecdsa > rsa). Leave commented out to keep the default.
#GITHUB_SSH_KEY=id_ed25519
