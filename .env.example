GITHUB_TOKEN=ghp_xxxxx
TAILSCALE_AUTH_KEY=tskey-auth-xxxxx

# Optional — lets the tailscale role disable node-key expiry for this machine
# (the CLI has no equivalent command, so the role calls the REST API).
#
# Create an OAuth client at
# https://login.tailscale.com/admin/settings/trust-credentials with the
# `devices:core` write scope — that scope's endpoint list is exactly what the
# role needs. The secret does not expire, is owned by the tailnet rather than
# by a person, and its use is recorded in the configuration audit log. Set both
# halves or neither; half a pair fails the play.
#
# TAILSCALE_API_ACCESS_TOKEN (a personal access token) is NO LONGER SUPPORTED:
# fully permitted, no scopes, and expires 90 days after minting. The role fails
# with migration instructions if it finds one set without an OAuth client.
#TAILSCALE_OAUTH_CLIENT_ID=kxxxxxxxxCNTRL
#TAILSCALE_OAUTH_CLIENT_SECRET=tskey-client-xxxxx

# Optional — force the github role to use a specific SSH key when ~/.ssh holds
# several. Accepts an absolute path, a ~/ path, or a bare name resolved under
# ~/.ssh; the .pub suffix is optional. When unset, the preferred key by type is
# used (ed25519 > ecdsa > rsa). Leave commented out to keep the default.
#GITHUB_SSH_KEY=id_ed25519
